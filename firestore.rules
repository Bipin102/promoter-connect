rules_version = '2';

// Deploy: Firebase Console → Firestore Database → Rules → paste this → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(id) { return isSignedIn() && request.auth.uid == id; }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Sample docs written by admin/seed.html.
    function isDemoId(id) { return id.matches('demo_.*'); }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // There's no backend, so the other party's client keeps these counters up to
    // date: the company bumps eventsCompleted when it closes an event, and the
    // rater updates the running average. Only a +1 step on those fields is allowed.
    function isCounterBump() {
      return isSignedIn() && (
        (changedKeys().hasOnly(['eventsCompleted']) &&
          request.resource.data.eventsCompleted == resource.data.get('eventsCompleted', 0) + 1) ||
        (changedKeys().hasOnly(['ratingAvg', 'ratingCount']) &&
          request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1 &&
          request.resource.data.ratingAvg >= 0 && request.resource.data.ratingAvg <= 5)
      );
    }

    function ratingBookingAllows(booking) {
      return booking.status == 'completed' && (
        (request.resource.data.fromRole == 'promoter' && booking.promoterId == request.auth.uid) ||
        (request.resource.data.fromRole == 'company' && booking.companyId == request.auth.uid)
      );
    }

    // Admins are added by hand in the Firebase console: create a doc at
    // admins/{auth-uid}. Nobody can write it from the client.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && request.resource.data.role == resource.data.role;
    }

    match /promoters/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || (isAdmin() && isDemoId(uid));
      allow update: if isCounterBump();

      match /portfolio/{imgId} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid) || (isAdmin() && isDemoId(uid));
      }
    }

    match /companies/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || (isAdmin() && isDemoId(uid));
      allow update: if isCounterBump();
    }

    match /events/{eventId} {
      // Job posts are public so people can see what's open before signing up.
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.companyId == request.auth.uid) ||
        (isAdmin() && isDemoId(eventId));
      // Other users (a promoter booking a spot, or anyone noticing an expired
      // urgent window) may only touch the fulfilment fields.
      allow update: if isSignedIn() && (
        resource.data.companyId == request.auth.uid ||
        (isAdmin() && isDemoId(eventId)) ||
        changedKeys().hasOnly(['positionsFilled', 'status', 'fulfilledAt', 'updatedAt'])
      );
      allow delete: if isOwner(resource.data.companyId);
    }

    match /applications/{appId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.promoterId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isSignedIn() &&
        get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.companyId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.status == 'booked' && (
        request.resource.data.promoterId == request.auth.uid ||
        request.resource.data.companyId == request.auth.uid
      );
      // Promoters move their own booking along; only the company can complete it.
      allow update: if isSignedIn() && (
        (resource.data.promoterId == request.auth.uid &&
          changedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in ['on_the_way', 'checked_in', 'cancelled']) ||
        (resource.data.companyId == request.auth.uid &&
          changedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt']))
      );
    }

    match /liveCheckIns/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.promoterId == request.auth.uid;
    }

    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      // Only someone on a completed booking can rate, once per side
      // (the `${bookingId}_${fromRole}` doc id in js/ratings.js).
      allow create: if (isAdmin() && isDemoId(ratingId)) || (
        isSignedIn() && request.resource.data.fromId == request.auth.uid &&
        request.resource.data.overall >= 1 && request.resource.data.overall <= 5 &&
        ratingBookingAllows(get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data)
      );
    }

    match /notifications/{id} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Written by the client of whoever triggered it (no backend). Contents are
      // escaped wherever they're shown.
      allow create: if isSignedIn();
    }

    match /payments/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && resource.data.companyId == request.auth.uid;
    }
  }
}
